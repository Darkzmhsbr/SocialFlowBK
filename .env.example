# ==============================
# SERVER
# ==============================
PORT=3000
NODE_ENV=development

# ==============================
# URLS
# In production these become your real Vercel/Railway/custom domain URLs.
# Nothing in the codebase should hardcode a domain - everything reads from here.
# ==============================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ==============================
# DATABASE (PostgreSQL / Railway)
# ==============================
DATABASE_URL=postgresql://postgres:tUOBgSkqAOcnryEYZdAwwuPLerOsEWbL@postgres.railway.internal:5432/railway

# ==============================
# META / INSTAGRAM APP CREDENTIALS
# Get these from Meta App Dashboard > Your App > Instagram > API setup with Instagram login
# NEVER commit real values. NEVER expose META_APP_SECRET to the frontend.
# ==============================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ==============================
# INSTAGRAM API CONFIGURATION
# Version confirmed against Meta's official docs at the time this project was generated (Aug 2026).
# Check https://developers.facebook.com/docs/graph-api/changelog before assuming this is still current.
# ==============================
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://api.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token

# Scopes requested during OAuth. Keep to the minimum needed for this MVP.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish

# ==============================
# SECURITY
# 32-byte (64 hex char) key used to encrypt access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================
TOKEN_ENCRYPTION_KEY=

# ==============================
# TEMPORARY: single-user placeholder until real auth exists (see section 14 of the project brief)
# ==============================
DEFAULT_USER_ID=temp-user-1
