// SocialFlow - database schema
// PostgreSQL, hosted on Railway.
//
// Only two models exist in this MVP: a minimal User (temporary, until real
// auth is built) and InstagramAccount (the actual focus of this version).
// The relation is already 1-to-many so multiple Instagram accounts per user
// works without a future migration reshaping the schema.
//
// Phase 2.1 additions (post scheduling foundation):
//   - MediaAsset:    each uploaded image/video, backed by object storage
//   - ScheduledPost: the actual post (draft/scheduled/published/etc)
//   - PostMedia:     pivot with `order` so carousels keep media sequence
//     and the same MediaAsset can be reused across multiple posts
//
// Phase 3.1 additions (auth foundation):
//   - User: gained passwordHash + name (both nullable so the temp-user-1
//     seeded by Phase 1 still validates; Phase 3.3 tightens them once
//     the default user is retired).
//   - InviteCode: single-use, optionally expiring token used to gate
//     registration during the closed beta.
//
// Rodada 2b (Fase 2.2b) addition:
//   - ScheduledPost.coverMediaAsset: optional custom cover image for
//     videos and reels. When null, Meta picks a frame automatically.
//
// Backblaze migration addition:
//   - StorageProvider enum + MediaAsset.storageProvider: which backend
//     hosts this asset. Legacy rows are CLOUDINARY; new uploads default
//     to BACKBLAZE. Enables cutover without touching any existing URL.
//   - cloudinaryPublicId column renamed to `storageKey` in code (via
//     @map). Column name in the DB stays the same so no data migration
//     is needed — only the Prisma-facing name is friendlier.
//
// Rodada 3 addition (metrics/insights):
//   - ScheduledPost.insightsData / insightsUpdatedAt: cache for Meta's
//     media insights so we don't hammer their API on every modal open.
//     Json column lets us store whatever shape Meta returns per post
//     type without more migrations when metrics evolve.
//
// Rodada 4 addition (multi-profile batch posting):
//   - ScheduledPost.batchId: groups the posts created together by the
//     batch composer (N media items x M Instagram accounts). Nullable —
//     posts created by the single composer keep batchId = null. No
//     separate table: batch status is derived by grouping posts. Applied
//     in production via POST /api/setup/migrate-rodada4-batch (idempotent
//     SQL), so `prisma db push` is not required for this change.
//
// Rodada 5 additions (account health + notifications):
//   - InstagramAccount: publishPausedUntil / pauseReason (worker skips the
//     account until then — Meta rate limit, daily publish limit, action
//     block) and lastError* / lastHealthCheckAt (periodic health check).
//   - Notification: messages shown in the header bell (account down,
//     account paused, batch finished, posts failed).
//   Applied via POST|GET /api/setup/migrate-rodada5-health (idempotent SQL).
//
// Rodada 7 additions (media library):
//   - MediaFolder: user-created folders for the library ("Memes", ...).
//   - MediaAsset.inLibrary: media the user chose to KEEP. The automatic
//     orphan cleanup (after a post is deleted) never touches these.
//   - MediaAsset.folderId: one folder per media (null = "Sem pasta").
//     Deleting a folder sets it to null (media stays in the library).
//   Applied via POST|GET /api/setup/migrate-rodada7-library (idempotent SQL).
//
// Rodada 8 additions (profile folders):
//   - AccountFolder: user-created groups of Instagram profiles ("Memes").
//   - AccountFolderMember: many-to-many — a profile can be in several
//     folders. Deleting a folder or a profile only removes the link.
//   Applied via POST|GET /api/setup/migrate-rodada8-account-folders.
//
// Rodada 10 additions (own Meta app per user):
//   - MetaAppCredential: one per user — Instagram App ID + App Secret
//     (secret encrypted with TOKEN_ENCRYPTION_KEY). When present, that
//     user's Instagram connections go through HIS app instead of the
//     server's default app (META_APP_ID / META_APP_SECRET).
//   - InstagramAccount.metaAppCredentialId: which app connected the profile
//     (null = default app). Removing the credential sets it to null.
//   Applied via POST|GET /api/setup/migrate-rodada10-meta-app.
//
// Rodada 12 additions (cleanup + reports):
//   - CleanupJob: one background cleanup (delete posts / archive posts /
//     free storage of published posts), with progress and final report.
//   - CleanupSetting: per-user automatic rules (daily).
//   - MediaAsset.purgedAt: file removed from storage by "liberar
//     armazenamento"; the row stays so published posts keep their history.
//   Applied via POST|GET /api/setup/migrate-rodada12-cleanup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 3.1: auth fields. Both nullable so pre-auth rows (like temp-user-1
  // created by /api/setup/default-user) don't fail schema validation.
  passwordHash String?
  name         String?

  instagramAccounts InstagramAccount[]
  mediaAssets       MediaAsset[]
  scheduledPosts    ScheduledPost[]

  // Phase 3.1: invites
  invitesCreated InviteCode[] @relation("InviteCreator")
  inviteUsed     InviteCode?  @relation("InviteConsumer")

  // Rodada 5: header notifications
  notifications  Notification[]

  // Rodada 7: media library folders
  mediaFolders   MediaFolder[]

  // Rodada 8: profile folders
  accountFolders AccountFolder[]

  // Rodada 10: own Meta app (optional, one per user)
  metaAppCredential MetaAppCredential?

  // Rodada 12: cleanup
  cleanupJobs    CleanupJob[]
  cleanupSetting CleanupSetting?

  @@map("users")
}

enum InstagramAccountStatus {
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  ERROR
}

model InstagramAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rodada 5: publishing pause + health. All nullable; cleared on reconnect.
  publishPausedUntil DateTime?
  pauseReason        String?   @db.Text
  lastErrorCode      String?
  lastErrorMessage   String?   @db.Text
  lastErrorAt        DateTime?
  lastHealthCheckAt  DateTime?

  instagramUserId  String @unique // ID returned by Meta for the authorized IG account
  username         String
  name             String?
  profilePictureUrl String?
  accountType      String? // BUSINESS | MEDIA_CREATOR

  // Never store a raw token. This column holds the ciphertext produced by
  // src/utils/crypto.js (encryptToken). The key lives only in TOKEN_ENCRYPTION_KEY.
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?

  status     InstagramAccountStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  lastSyncAt DateTime?

  scheduledPosts ScheduledPost[]

  // Rodada 8: folders this profile belongs to
  folderMemberships AccountFolderMember[]

  // Rodada 10: app used to connect this profile (null = default app)
  metaAppCredentialId String?
  metaAppCredential   MetaAppCredential? @relation(fields: [metaAppCredentialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([metaAppCredentialId])
  @@map("instagram_accounts")
}

// --- Phase 2.1: media + scheduled posts --------------------------------

enum MediaType {
  IMAGE
  VIDEO
}

// Which object storage hosts the asset. Legacy Cloudinary rows keep
// working forever — their public URLs never change. New uploads default
// to BACKBLAZE. The mediaService reads this field to route delete calls
// to the correct client.
enum StorageProvider {
  CLOUDINARY
  BACKBLAZE
}

// A single uploaded asset stored on an object storage provider. Never
// stores the file bytes — only metadata + the public HTTPS URL that
// Instagram will fetch at publish time.
model MediaAsset {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type               MediaType
  // Provider-specific identifier. For CLOUDINARY it's the public_id used
  // by their SDK; for BACKBLAZE it's the S3 object key (e.g.
  // "users/<userId>/<uuid>.jpg"). Column name kept as "cloudinaryPublicId"
  // via @map so this rename doesn't need a data migration.
  storageKey         String    @unique @map("cloudinaryPublicId")
  storageProvider    StorageProvider @default(BACKBLAZE)
  url                String              // HTTPS delivery URL (what Instagram fetches)
  format             String              // "jpg", "png", "mp4", "mov"
  bytes              Int
  width              Int?
  height             Int?
  durationSec        Float?              // only set for VIDEO

  // Rodada 7: media library.
  inLibrary          Boolean      @default(false)
  folderId           String?
  folder             MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Rodada 12: file deleted from storage by a cleanup (row kept for history)
  purgedAt           DateTime?

  createdAt          DateTime  @default(now())

  postMedias         PostMedia[]
  // Rodada 2b: same MediaAsset can be referenced as cover art by many
  // ScheduledPosts. Back-relation to ScheduledPost.coverMediaAsset.
  postCovers         ScheduledPost[]

  @@index([userId])
  @@index([folderId])
  @@map("media_assets")
}

enum ScheduledPostType {
  FEED_IMAGE      // 1 image on the feed
  FEED_VIDEO      // 1 video on the feed
  FEED_CAROUSEL   // 2-10 images/videos on the feed
  REEL            // 1 vertical video posted as Reel
  STORY           // 1 image/video story
}

enum ScheduledPostStatus {
  DRAFT       // user is still composing; not scheduled yet
  SCHEDULED   // has scheduledFor in the future; waiting for the worker
  QUEUED      // worker picked it up; about to hit Instagram
  PUBLISHING  // Instagram media container created; polling for readiness
  PUBLISHED   // publish succeeded; instagramMediaId is set
  FAILED      // publish failed; failureReason is set
  ARCHIVED    // user archived it manually
}

model ScheduledPost {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccountId String
  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  type               ScheduledPostType
  caption            String?             @db.Text
  status             ScheduledPostStatus @default(DRAFT)
  scheduledFor       DateTime?
  publishedAt        DateTime?
  instagramMediaId   String?             // id Meta returns after /media_publish
  failureReason      String?             @db.Text
  retryCount         Int                 @default(0)

  // Rodada 2b: optional custom cover for FEED_VIDEO and REEL. Meta wants
  // this as a URL (cover_url) at container creation time. onDelete: SetNull
  // means deleting the MediaAsset used as cover just clears this field —
  // the post itself survives and Meta picks a frame automatically at
  // publish time. Enforced to be an IMAGE by scheduledPostService.
  coverMediaAssetId  String?
  coverMediaAsset    MediaAsset?         @relation(fields: [coverMediaAssetId], references: [id], onDelete: SetNull)

  // Rodada 3: metrics cache. insightsData holds the normalized shape
  // produced by instagramInsightsService (see toPublicInsights() there).
  // insightsUpdatedAt drives cache expiry (default TTL 1h). Both null
  // until the user opens the metrics modal for the first time on this
  // post. Json (not discrete columns) so new Meta metrics don't need
  // another migration.
  insightsData       Json?
  insightsUpdatedAt  DateTime?

  // Rodada 4: batch grouping. Every post created by POST /api/posts/batch
  // shares the same batchId (uuid generated by scheduledPostService). The
  // worker never reads this field — each post is still published on its
  // own, so a failure on one account never affects the others.
  batchId            String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  medias             PostMedia[]

  // Composite index used by the worker (Phase 2.2):
  //   WHERE status = 'SCHEDULED' AND scheduledFor <= NOW()
  @@index([userId])
  @@index([instagramAccountId])
  @@index([status, scheduledFor])
  @@index([coverMediaAssetId])
  // Rodada 4: lookups by batch (GET/DELETE /api/posts/batch/:batchId).
  @@index([batchId])
  @@map("scheduled_posts")
}

// Pivot between ScheduledPost and MediaAsset. `order` matters for carousels.
model PostMedia {
  id           String        @id @default(uuid())
  postId       String
  mediaAssetId String
  order        Int

  post         ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([postId, order])
  @@index([postId])
  @@index([mediaAssetId])
  @@map("post_media")
}

// --- Phase 3.1: invite-only registration -------------------------------

// Single-use registration token. During the closed beta, /api/auth/register
// only succeeds if the caller presents a valid, unused, unexpired code.
// After beta this table stays useful for referral flows or admin resets.
model InviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteConsumer", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  note        String?   // optional label, e.g. "convite João" for tracking
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@map("invite_codes")
}

// --- Rodada 5: notifications ---------------------------------------------

// One message in the header bell. type is a free string (ACCOUNT_DOWN,
// ACCOUNT_PAUSED, BATCH_COMPLETED, POSTS_FAILED, ...) so new kinds don't
// need migrations. dedupeKey lets the backend avoid repeating the same
// alert (e.g. one "paused" message per pause, not one per post).
// instagramAccountId/postId/batchId are plain strings on purpose (no FK):
// the notification must survive the account or post being deleted.
model Notification {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  severity           String    @default("info") // info | success | warning | error
  title              String
  message            String?   @db.Text
  instagramAccountId String?
  postId             String?
  batchId            String?
  dedupeKey          String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([dedupeKey])
  @@map("notifications")
}

// --- Rodada 7: media library folders ---------------------------------------

model MediaFolder {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  medias    MediaAsset[]

  @@unique([userId, name])
  @@index([userId])
  @@map("media_folders")
}

// --- Rodada 8: profile folders ---------------------------------------------

model AccountFolder {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  members   AccountFolderMember[]

  @@unique([userId, name])
  @@index([userId])
  @@map("account_folders")
}

model AccountFolderMember {
  folderId           String
  folder             AccountFolder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@id([folderId, instagramAccountId])
  @@index([instagramAccountId])
  @@map("account_folder_members")
}

// --- Rodada 10: own Meta app per user ----------------------------------------

model MetaAppCredential {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId              String             // Instagram App ID (NOT the Meta app container ID)
  appSecretEncrypted String             // Instagram App Secret, encrypted (utils/crypto)
  status             String             @default("PENDING") // PENDING | VERIFIED | ERROR
  verifiedAt         DateTime?
  lastErrorMessage   String?            @db.Text
  lastErrorAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  instagramAccounts  InstagramAccount[]

  @@map("meta_app_credentials")
}

// --- Rodada 12: cleanup + reports --------------------------------------------

model CleanupJob {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String    @default("MANUAL") // MANUAL | AUTO
  action          String    // DELETE_POSTS | ARCHIVE_POSTS | FREE_STORAGE
  status          String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELED
  filter          Json?
  matched         Int       @default(0)
  processed       Int       @default(0)
  affected        Int       @default(0)
  skipped         Int       @default(0)
  mediaDeleted    Int       @default(0)
  bytesFreed      Float     @default(0)
  skippedReasons  Json?
  cursor          String?
  cancelRequested Boolean   @default(false)
  errorMessage    String?   @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("cleanup_jobs")
}

model CleanupSetting {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  freeStorageAfterDays   Int?      // null = off
  archiveFailedAfterDays Int?      // null = off
  lastAutoRunAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("cleanup_settings")
}
